//! param: bibliography(逐表覆盖)
//! values: 每个可覆盖参数：全局设一个值、本表设另一个值 → 本表胜出
#import "/tests/_fixture/probe.typ": *
#show: spec.with(param: "bibliography(..) 逐表覆盖", controls: "`bibliography()` 的同名参数覆盖全局，`auto` 继承。",
  expect: [本文件*逐个*走一遍所有可覆盖参数：每块把*全局*设成一个值、把*本表*设成另一个值，
    表里印出来的必须是*本表*那个值。缺省 `auto`（或 `none`）表示「继承全局」。
    这是覆盖*链路*的测试——每个参数具体取值的语义在它自己那一节（`0x-*` 各文件）。
    ⚠️ 逐次 `#cite(..)` 的覆盖是另一条链（见 `14-per-cite/`）；
    `correct-punct` *不能*逐表覆盖（矫正在解析期一次性完成，要换得换一个 `gb7714(..)` 实例）。])
#let mixed = bytes(read("/tests/_fixture/main.bib") + read("/tests/_fixture/edge.bib"))
#let cs = (<bm-zh>, <bm-en>, <aj-zh>, <bm-online>, <bm-noauthor>, <dt-zh>, <pt-zh>, <ti-multivolume>, <rel-zh>, <an-a>, <kw-a>, <pid-isbn>)
#let ov(name, global-cfg, list-args) = case(name, global-cfg, cites: cs, bib: mixed, full: false, bib-args: list-args)

