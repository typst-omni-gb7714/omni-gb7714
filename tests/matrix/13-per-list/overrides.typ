#ov("disambiguate", gb7714.with(disambiguate: false), (disambiguate: true))
#ov("sort-by", gb7714.with(bib-sort-by: ("title",)), (sort-by: ((date: "descending"),)))
#ov("sort-zh-by", gb7714.with(bib-sort-zh-by: "pinyin"), (sort-zh-by: "bihua"))
