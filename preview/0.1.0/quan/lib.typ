#let _font-profile(name) = _FONT-METRICS.at(lower(name), default:
  _FONT-METRICS.at(_FIT-ALIASES.at(lower(name), default: lower(name)), default: none))

#let _reference-entry(font, reference, strict: false) = {
  let stack = if type(font) == array { font } else { (font,) }
  for entry in stack {
    if not _covers-char(entry, reference) { continue }
    let name = if type(entry) == dictionary { entry.at("name", default: "") } else { str(entry) }
    let family = _FIT-ALIASES.at(lower(name), default: lower(name))
    let profile = _font-profile(name)
    if profile != none {
      if reference in profile.glyphs and _font-measures-match(entry, reference, strict: strict) { return (name: name, family: family) }
    } else if family in _CIRCLE-STROKES and _font-measures-match(entry, reference, strict: strict) {
      return (name: name, family: family)
    } else if (_FIT-DIGIT-ALIASES.at(family, default: none) not in ("times", "courier")
      and family not in ("arial", "new computer modern", "stixgeneral")) { return none }
  }
  none
}

#let _circle-family(font, reference) = {
  let entry = _reference-entry(font, reference)
  if entry == none { none } else { entry.family }
}

#let _digit-font(font) = {
  let stack = if type(font) == array { font } else { (font,) }
  for entry in stack {
    if not _covers-char(entry, "0") { continue }
    let name = if type(entry) == dictionary { entry.at("name", default: "") } else { str(entry) }
    let profile = _font-profile(name)
    if profile == none { return none }
    if profile.digits and _font-measures-match(entry, "0") { return name }
  }
  none
}

#let _fit-text-compatible() = (text.number-type == auto and text.number-width == auto
  and text.style == "normal" and text.stretch == 100% and text.script == auto
  and text.features.len() == 0 and text.tracking.to-absolute() == 0pt and text.kerning)

#let _fit-groups-for(font, weight, reference: "①", extra: true, auto-value: none) = {
  let stack = if type(font) == array { font } else { (font,) }
  let automatic = auto-value != none
  if automatic and not _fit-text-compatible() { return none }
  let circle = _reference-entry(font, reference, strict: automatic)
  if circle == none or circle.family not in _DIGIT-FIT { return none }
  let provider = circle.family
  let digits = if automatic { str(auto-value).clusters() } else { ("0",) }
  let entries = digits.map(ch => stack.find(f => _covers-char(f, ch) and _font-measures-match(f, ch, strict: automatic)))
  let entry = entries.first()
  if entry == none or entries.any(f => f != entry) { return none }
  let name = lower(if type(entry) == dictionary { entry.at("name", default: "") } else { str(entry) })
  let digit = _FIT-DIGIT-ALIASES.at(name, default: none)
  if digit == none or digit not in _DIGIT-FIT.at(provider) { return none }
  let fresh = provider in _FIT-EXTRA and digit in _FIT-EXTRA.at(provider)
  if fresh and (not extra or not _fit-text-compatible()) { return none }
  let weights = _DIGIT-FIT.at(provider).at(digit)
  weights.at(if _weight-num(weight) >= 600 { "bold" } else { "regular" },
    default: if automatic { none } else { weights.at("regular", default: none) })
}

#let _fit-group(n) = {
  if n < 10 { if n == 1 { "single-1" } else { "single" } }
  else if n == 11 { "all-ones" }
  else if str(n).contains("1") { "two-with-1" }
  else { "two" }
}

#let _quan-draw-state = state("quan-draw", (
  default: (
    stroke:   0.0315em,
    radius:   50%,
    inset:    (x: 0.05em, y: 0.015em),
    outset:   (y: 0.15em),
    baseline: -0.06em,
    size:     0.825em,
    height:   auto,
    kern:     -0.075em,
    gap:      0.1em,
    digit-fit: none,
  ),
  rules: _RULES.song,

  user-rules: (),
  user-keys: (),
))

#let quan-init(

  digits: none
) = {
  let parsed = if digits != none { _parse-int-ranges(digits) } else { () }
  _quan-state.update(_ => (digits: parsed))
}

#let quan-style(

  stroke:   none,

  radius:   none,

  inset:    none,

  outset:   none,

  baseline: none,

  size:     none,

  height:   none,

  kern:     none,

  gap:      none,

  digit-fit: none,

  ..rules,
) = {
  assert(digit-fit in (none, true, false),
    message: "quan-style: `digit-fit` must be a boolean, got " + repr(digit-fit))

  let parsed = rules.pos().map(rule => {
    assert(
      type(rule) == array and rule.len() == 2
        and type(rule.at(0)) == str and type(rule.at(1)) == dictionary,
      message: "quan-style: positional args must be (range-str, style-dict) tuples",
    )
    (values: _parse-int-ranges(rule.at(0)), style: rule.at(1))
  })
  let named = (stroke: stroke, radius: radius, inset: inset, outset: outset,
               baseline: baseline, size: size, height: height, kern: kern, gap: gap,
               digit-fit: digit-fit)
  _quan-draw-state.update(prev => {
    let d = prev.default
    let keys = prev.user-keys
    for (k, v) in named.pairs() {
      if v != none {
        d.insert(k, v)
        if k not in keys { keys.push(k) }
      }
    }
    (default: d, rules: prev.rules,
     user-rules: prev.user-rules + parsed, user-keys: keys)
  })
}

#let _circled-digit(n) = {
  if      n == 0               { str.from-unicode(0x24EA) }
  else if n >= 1  and n <= 20  { str.from-unicode(0x245F + n) }
  else if n >= 21 and n <= 35  { str.from-unicode(0x3251 + (n - 21)) }
  else if n >= 36 and n <= 50  { str.from-unicode(0x32B1 + (n - 36)) }
  else { none }
}

#let _resolve-style(value, draw-cfg, picked: none) = {
  let s = draw-cfg.default
  let user-keys = draw-cfg.user-keys
  let rules = if picked == none { draw-cfg.rules } else { picked.rules }
  s.insert("cap", if picked == none { 0.684 } else { picked.cap })
  if type(value) == int {
    for rule in rules {
      if value in rule.values {
        for (k, v) in rule.style.pairs() { s.insert(k, v) }
        break
      }
    }
    for k in draw-cfg.user-keys {
      s.insert(k, draw-cfg.default.at(k))
    }
    for rule in draw-cfg.user-rules {
      if value in rule.values {
        for (k, v) in rule.style.pairs() {
          s.insert(k, v)
          if k not in user-keys { user-keys.push(k) }
        }
      }
    }
  }
  s.insert("user-keys", user-keys)
  s
}

#let _side(value, side) = {
  if type(value) != dictionary { return value.to-absolute() }
  let axis = if side in ("left", "right") { "x" } else { "y" }
  value.at(side, default: value.at(axis, default: value.at("rest", default: 0pt))).to-absolute()
}

#let _FIT-APPROX = (
  regular: (
    "single-1": (0.9803, 0.6338),
    "single": (0.9178, 0.6471),
    "all-ones": (0.6018, 0.6063),
    "two-with-1": (0.6325, 0.6341),
    "two": (0.6440, 0.5798),
  ),
  bold: (
    "single-1": (0.9047, 0.6202),
    "single": (0.9158, 0.6354),
