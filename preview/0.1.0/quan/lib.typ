#let _ellipse-contour(cx, cy, rx, ry, control: 0.5522847498307936) = {
  let k = control
  (
    curve.move((cx + rx, cy)),
    curve.cubic((cx + rx, cy + k * ry), (cx + k * rx, cy + ry), (cx, cy + ry)),
    curve.cubic((cx - k * rx, cy + ry), (cx - rx, cy + k * ry), (cx - rx, cy)),
    curve.cubic((cx - rx, cy - k * ry), (cx - k * rx, cy - ry), (cx, cy - ry)),
    curve.cubic((cx + k * rx, cy - ry), (cx + rx, cy - k * ry), (cx + rx, cy)),
    curve.close(),
  )
}

#let _directional-ring(diameter, horizontal, vertical, paint, diagonal: none) = {
  let r = diameter / 2
  assert(horizontal > 0pt and vertical > 0pt and calc.max(horizontal, vertical) < r,
    message: "quan: invalid calibrated ring thickness")

  let k = if diagonal == none { 0.5522847498307936 } else {
    let diagonal-radius = calc.sqrt(calc.pow((r - horizontal) / 1pt, 2)
      + calc.pow((r - vertical) / 1pt, 2)) * 1pt
    ((r - diagonal) / diagonal-radius - 0.5) / 0.375
  }
  assert(k > 0 and k < 1, message: "quan: invalid inner ring contour")
  curve(
    fill: paint,
    stroke: none,
    fill-rule: "even-odd",
    .._ellipse-contour(r, r, r, r),
    .._ellipse-contour(r, r, r - horizontal, r - vertical, control: k),
  )
}

#let _drawn-core(body, value: none, display-scale: 1) = context {
  let s = _resolve-style(value, _quan-draw-state.get(), picked: _pick-rules(text.font))
  let sk = stroke(s.stroke)

  let factor = calc.max(1.0, 1.0 + (_weight-num(text.weight) - 400) / 400 * 0.6)
  let legacy-thickness = (0.0315em * factor).to-absolute()
  let half = s.gap / 2
  let it = _side(s.inset, "top")
  let ib = _side(s.inset, "bottom")
  let il = _side(s.inset, "left")
  let ir = _side(s.inset, "right")
  let ot = _side(s.outset, "top")
  let ob = _side(s.outset, "bottom")
  let ol = _side(s.outset, "left")
  let oright = _side(s.outset, "right")
  let coverage = _quan-state.get().digits.filter(n => _circled-digit(n) != none)
  let reference-value = if coverage.len() == 0 { none } else if 10 in coverage { 10 } else { coverage.last() }
  let glyph = if reference-value == none { none } else { _circled-digit(reference-value) }
  let reference = text(top-edge: "bounds", bottom-edge: "bounds", if glyph == none { "0" } else { glyph })
  let custom-geometry = s.user-keys.any(k => k in ("size", "height", "inset", "outset"))
  let native-geometry = glyph != none and s.height == auto and not custom-geometry
  let axes = if (native-geometry and "stroke" not in s.user-keys
    and "radius" not in s.user-keys and reference-value >= 1 and reference-value <= 10) {
    let family = _circle-family(text.font, glyph)
    if family == none or family not in _CIRCLE-AXES { none } else {
      _CIRCLE-AXES.at(family).at(if _weight-num(text.weight) >= 600 { 1 } else { 0 })
    }
  } else { none }
  let calibrated = if axes != none {

    measure(reference).height * calc.max(..axes)
  } else if (native-geometry and "stroke" not in s.user-keys
    and reference-value >= 1 and reference-value <= 10) {
    let family = _circle-family(text.font, glyph)
    if family == none or family not in _CIRCLE-STROKES { none } else {
      measure(reference).height * _CIRCLE-STROKES.at(family).at(if _weight-num(text.weight) >= 600 { 1 } else { 0 })
    }
  } else { none }
  if sk.paint == auto {
    let th = if sk.thickness == auto { 0.0315em } else { sk.thickness }
    sk = stroke((paint: text.fill, thickness: if calibrated == none { th * factor } else { calibrated },
                 cap: sk.cap, join: sk.join, dash: sk.dash, miter-limit: sk.miter-limit))
  }
  let thickness = if sk.thickness == auto { 0pt } else { sk.thickness.to-absolute() }
  let diameter = if native-geometry {

    calc.max(1pt, measure(reference).height - thickness)
  } else {
    (if s.height == auto { s.size * s.cap + it + ib } else { s.height }).to-absolute() + ot + ob
  }
  let descent = measure(text(top-edge: "baseline", bottom-edge: "bounds", if glyph == none { "0" } else { glyph })).height
  let line-height = measure(text(if glyph == none { "0" } else { glyph })).height
  let line-descent = measure(text(top-edge: "baseline", if glyph == none { "0" } else { glyph })).height

  let ot = if native-geometry { measure(reference).height - descent - line-height + line-descent - thickness / 2 } else { ot }
  let ob = if native-geometry { descent - line-descent - thickness / 2 } else { ob }

  let stroke-outset = if calibrated == none { 0pt } else { (legacy-thickness - thickness) / 2 }
  let ol = if native-geometry { stroke-outset } else { ol }
  let oright = if native-geometry { stroke-outset } else { oright }
  let height = diameter - ot - ob

  let width = diameter - ol - oright
  assert(width > 0pt and height > 0pt, message: "quan: outset exceeds the circle size")
  let available = calc.max(1pt, if calibrated == none {
    diameter - calc.max(il + ir, it + ib) - thickness
  } else {

    let old = calc.max(1pt, measure(reference).height - legacy-thickness) - calc.max(il + ir, it + ib) - legacy-thickness
    let clear = measure(reference).height - 2 * thickness - 2 * calc.max(0.02 * measure(reference).height, 0.12pt)
    calc.min(old, clear)
  })

  let fit-setting = s.at("digit-fit", default: none)
  let custom-outline = s.user-keys.any(key => key in ("stroke", "radius"))
  let can-fit = native-geometry and value != none and (fit-setting == true or (
    fit-setting == none and value >= 0 and value <= 99 and not custom-outline and "kern" not in s.user-keys
  ))
  let groups = if can-fit {
    _fit-groups-for(text.font, text.weight, reference: glyph, extra: not custom-outline,
      auto-value: if fit-setting == none { value } else { none })
  } else { none }
  let fit = if can-fit and (fit-setting == true or (groups != none and _fit-group(value) in groups)) {
    let ref-h = measure(reference).height

    let inner = ref-h - 2 * thickness - 2 * calc.max(0.02 * ref-h, 0.12pt)

    let clearance-scale = if calibrated == none or thickness <= legacy-thickness { 1 } else {
      let margin = calc.max(0.005 * ref-h, 0.12pt)
      calc.min(1, calc.max(0pt, ref-h - 2 * thickness - 2 * margin) / calc.max(0.01pt, ref-h - 2 * legacy-thickness))
    }
    _fit-drawn(value, ref-h, available, text.weight, inner, groups, clearance-scale: clearance-scale)
  } else { none }
  let fitted = if fit != none { fit.at(0) } else {

    let automatic-kern = "kern" not in s.user-keys and s.kern < 0pt
    let points = s.size.to-absolute() / 1pt * display-scale
    let amount = calc.clamp((points - 6) / 8, 0, 1)
    let kern = if automatic-kern { calc.max(s.kern, -0.025em) * amount } else { s.kern }
    let digits = text(size: s.size, tracking: kern, baseline: 0pt,
      top-edge: "bounds", bottom-edge: "bounds", body)
    let ink = measure(text(top-edge: "bounds", bottom-edge: "bounds", digits))

    let diagonal = calc.sqrt(calc.pow(ink.width / 1pt, 2) + calc.pow(ink.height / 1pt, 2)) * 1pt
    let factor = if diagonal > available { available / diagonal } else { 1 }
    if factor < 1 { scale(x: factor * 100%, y: factor * 100%, reflow: true, digits) } else { digits }
  }
  let fit-dx = if fit == none { 0pt } else { fit.at(1) }
  let fit-dy = if fit == none { 0pt } else { fit.at(2) }
  let baseline = if native-geometry { line-descent + if "baseline" in s.user-keys { s.baseline } else { 0pt } }
    else { descent + (diameter - measure(reference).height) / 2 + s.baseline }
  h(half)
  box(
    stroke:   if axes == none { sk } else { none },
    radius:   s.radius,
    inset:    0pt,
    outset:   (top: ot, bottom: ob, left: ol, right: oright),
    baseline: baseline,
    width:    width,
    height:   height,
    {
      if axes != none {
        place(top + left, dx: -ol - thickness / 2, dy: -ot - thickness / 2,
          _directional-ring(diameter + thickness,
            measure(reference).height * axes.at(0),
            measure(reference).height * axes.at(1), sk.paint,
            diagonal: measure(reference).height * axes.at(2)))
      }
      place(center + horizon, dx: (oright - ol) / 2 + fit-dx, dy: (ob - ot) / 2 + fit-dy,
        if fit != none { text(baseline: 0pt, fitted) } else { fitted })
    },
  )

  "\u{200C}"
  h(half)
}

#let _reference-font(font, reference) = {
  let entry = _reference-entry(font, reference)
  if entry == none { none } else { entry.name }
}

#let _reset-script-sub(body) = sub(typographic: false, size: 1em, baseline: 0em, text(baseline: 0pt, body))
#let _reset-script-super(body) = super(typographic: false, size: 1em, baseline: 0em, text(baseline: 0pt, body))

#let _reset-relative-sub(body) = {
  show strong: it => it.body
  show emph: it => it.body
  _reset-script-sub(body)
}
#let _reset-relative-super(body) = {
  show strong: it => it.body
  show emph: it => it.body
  _reset-script-super(body)
}

#let _script-style() = (text.font, text.size, text.weight, text.style, text.stretch,
  text.fill, text.features, text.tracking, text.spacing, text.number-type,
  text.number-width, text.lang, text.region, text.script, text.dir, text.fallback)

#let _script-sentinel(expected) = context {
  box(width: if _script-style() == expected { 1pt } else { 2pt }, height: 1pt)
}

#let _script-unit-valid(reset, sentinel) = {
  let unit = measure(reset(sentinel))
  calc.abs(unit.width - 1pt) < 0.01pt and calc.abs(unit.height - 1pt) < 0.01pt
}

#let _probe-script-scale(bounds) = {
  let current-width = measure(bounds).width
  let sub-width = measure(_reset-relative-sub(bounds)).width
  let super-width = measure(_reset-relative-super(bounds)).width
  if (calc.abs(sub-width - current-width) < 0.001pt
    and calc.abs(super-width - current-width) < 0.001pt) { return none }
  let sentinel = _script-sentinel(_script-style())
  let control = text(tracking: 0pt, spacing: 100%, top-edge: "bounds", bottom-edge: "bounds", "MmWwgj0123456789")
  let inspect(reset, width) = {
    if not _script-unit-valid(reset, sentinel) { return none }
    let sample = measure(reset(control))
    if width <= 0.001pt or sample.width <= 0.001pt { return none }
    (width: width, control-width: sample.width, control-height: sample.height)
  }
  let a = inspect(_reset-relative-sub, sub-width)
  let b = inspect(_reset-relative-super, super-width)
  if a == none and b == none { return none }
  let close(x,y) = calc.abs(x - y) < calc.max(0.01pt, calc.abs(y) * 0.005)
  if a != none and b != none and not (close(a.width,b.width)
    and close(a.control-width,b.control-width) and close(a.control-height,b.control-height)) {
    let current-control = measure(control).width
    let consistent(item) = close(current-width / item.width * 1pt, current-control / item.control-width * 1pt)
    let a-good = consistent(a)
    let b-good = consistent(b)
    if a-good == b-good { return none }
    if a-good { b = none } else { a = none }
  }
  let neutral = if a != none { a } else { b }
  let scale = current-width / neutral.width
  if scale <= 0.001 { return none }
  (scale: scale, sub: a != none, super: b != none)
}

#let _fallback-script-font(reference, bounds) = {
  let signatures = _FALLBACK-SIGNATURES.at(reference, default: ())
  if signatures.len() == 0 { return none }
  let unit = 1em.to-absolute()
  let top = measure(text(top-edge: "bounds", bottom-edge: "baseline", reference)).height / unit
  let bottom = measure(text(top-edge: "baseline", bottom-edge: "bounds", reference)).height / unit
  let matches = signatures.filter(item => calc.abs(item.at(1) - top) < 0.00001 and calc.abs(item.at(2) - bottom) < 0.00001)
  if matches.len() == 0 { return none }
  let sentinel = _script-sentinel(_script-style())
  for reset in (_reset-relative-sub, _reset-relative-super) {
    if not _script-unit-valid(reset, sentinel) { continue }
    let width = measure(reset(bounds)).width / unit
    if matches.any(item => calc.abs(item.at(0) - width) < 0.00001) { return "Libertinus Serif" }
  }
  none
}

#let _script-shift(font) = {
  let a = measure(text(font: font, box(width: 0pt, height: 0pt, baseline: 1em))).height
  let b = measure(text(font: font, box(width: 0pt, height: 0pt, baseline: -1em))).height
  (b - a) / 2
}

#let _drawn(body, value: none) = context {
  if sys.version < version(0, 14, 0) { return _drawn-core(body, value: value) }
  let shift = _script-shift(text.font)
  let shifted = calc.abs(shift - text.baseline.to-absolute()) > 0.01pt

  let first = if type(text.font) == array { text.font.first() } else { text.font }
  let first-name = if type(first) == dictionary { first.at("name", default: "") } else { str(first) }
  let first-profile = _font-profile(first-name)
  if not shifted and first-profile != none and first-profile.frame-fast and first-profile.quad != none {
    let scale = (measure(text(font: (first-name,), tracking: 0pt, spacing: 100%, "\u{2001}")).width /
      (first-profile.quad * 1em.to-absolute()))
    if calc.abs(scale - 1) <= 0.005 { return _drawn-core(body, value: value) }
  }
  let coverage = _quan-state.get().digits.filter(n => _circled-digit(n) != none)
  let reference-value = if coverage.len() == 0 { none } else if 10 in coverage { 10 } else { coverage.last() }
  let glyph = if reference-value == none { none } else { _circled-digit(reference-value) }
  let digit-font = if glyph == none { _digit-font(text.font) } else { none }
  let bounds = text(top-edge: "bounds", bottom-edge: "bounds", if glyph == none { "MmWwgj" } else { glyph })
  let provider = if glyph == none { none } else { _reference-font(text.font, glyph) }
  let script-font = if glyph == none { digit-font } else if provider != none { provider }
    else { _fallback-script-font(glyph, bounds) }
  let profile = if script-font == none { none } else { _font-profile(script-font) }
  let quad = if profile == none { none } else { profile.quad }
  let bounds = if quad == none { bounds } else {
    text(font: (script-font,), tracking: 0pt, spacing: 100%, top-edge: "bounds", bottom-edge: "bounds", "\u{2001}")
  }
  let relative-probe = if quad != none { none } else { _probe-script-scale(bounds) }
  let measured-scale = if quad != none { measure(bounds).width / (quad * 1em.to-absolute()) }
    else if relative-probe != none { relative-probe.scale } else { 1 }
  if not shifted and calc.abs(measured-scale - 1) <= 0.005 { return _drawn-core(body, value: value) }
  let expected-width = measure(bounds).width / calc.max(0.001, measured-scale)
  let sentinel = _script-sentinel(_script-style())
  let usable(reset) = (_script-unit-valid(reset, sentinel) and
    calc.abs(measure(reset(bounds)).width - expected-width) < calc.max(0.01pt, expected-width * 0.005))
  let sub-usable = (relative-probe == none or relative-probe.sub) and usable(_reset-relative-sub)
  let super-usable = not sub-usable and (relative-probe == none or relative-probe.super) and usable(_reset-relative-super)
  let reset = if sub-usable { _reset-relative-sub } else if super-usable { _reset-relative-super }
    else { none }
  if reset == none { return _drawn-core(body, value: value) }
  let factor = measure(bounds).width / measure(reset(bounds)).width
  let native-shift = if script-font == none { shift } else { _script-shift((script-font,)) }
  let adjustment = native-shift - shift
  box(move(dy: (if sys.version >= version(0, 15, 0) { shift } else { 0pt }) + adjustment,
    scale(x: factor * 100%, y: factor * 100%, reflow: true, reset(_drawn-core(body, value: value, display-scale: factor)))))
}

#let quan(

  value
) = {
  assert(type(value) == int, message: "quan: expected int, got " + str(type(value)))
  context {
    let cfg = _quan-state.get()
    let g = _circled-digit(value)
    if g == none or value not in cfg.digits {
      _drawn(str(value), value: value)
    } else {
      g
    }
  }
}

#let quan-footnote(

  body
) = {
  set footnote(numbering: quan)
  body
}
